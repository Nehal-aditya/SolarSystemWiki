<Page
    x:Class="SolarSystemWiki.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SolarSystemWiki.Models"
    xmlns:controls="using:SolarSystemWiki.Controls"
    xmlns:converters="using:SolarSystemWiki.Helpers"
    Background="Transparent">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NullToVisibilityConverter x:Key="NotNullToVis" Inverse="True"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToSolidBrushConverter x:Key="ColorToBrush"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Grid Grid.Column="0" Background="{ThemeResource NavigationViewExpandedPaneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header + search -->
            <StackPanel Grid.Row="0" Margin="12,12,12,8" Spacing="8">
                <TextBlock Text="Entries" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="4,0"/>
                <AutoSuggestBox
                    PlaceholderText="Search…"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    CornerRadius="8"/>
            </StackPanel>

            <!-- Category chips -->
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" Padding="12,0,12,10">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{x:Bind}" Tag="{x:Bind}" Padding="10,4" FontSize="11" CornerRadius="12" Click="CategoryChip_Click"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Entry list -->
            <ListView
                Grid.Row="2"
                ItemsSource="{x:Bind ViewModel.FilteredEntries}"
                SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=OneWay}"
                SelectionChanged="EntryList_SelectionChanged"
                Padding="6,0,6,8"
                Background="Transparent"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:WikiEntry">
                        <Grid Padding="8,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                    Background="{x:Bind AccentColor, Converter={StaticResource ColorToBrush}}">
                                <TextBlock Text="{x:Bind Emoji}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center" Margin="16,24" Spacing="6">
                        <TextBlock Text="🌌" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="No entries yet" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Click + New Entry to start." Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ListView.Footer>
            </ListView>

            <!-- New Entry button -->
            <Button Grid.Row="3" HorizontalAlignment="Stretch" Margin="12,6,12,14"
                    Padding="0,12" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Click="NewEntry_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="New Entry"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Background="Transparent">

            <!-- Empty state (no selection) -->
            <StackPanel
                Visibility="{x:Bind ViewModel.SelectedEntry, Mode=OneWay, Converter={StaticResource NullToVis}}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="380">
                <TextBlock Text="🔭" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="Solar System Wiki" Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock
                    Text="Select an entry from the sidebar, or create a new one to start building your wiki."
                    Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center"
                    TextAlignment="Center" TextWrapping="WrapWholeWords"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="＋  Create your first entry" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="20,10" CornerRadius="8" Click="NewEntry_Click"/>
            </StackPanel>

            <!-- Detail view -->
            <controls:EntryDetailPanel
                x:Name="DetailPanel"
                Entry="{x:Bind ViewModel.SelectedEntry, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.SelectedEntry, Mode=OneWay, Converter={StaticResource NotNullToVis}}"
                EditRequested="DetailPanel_EditRequested"
                DeleteRequested="DetailPanel_DeleteRequested"/>
        </Grid>

        <!-- Status toast -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Column="1"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Success"
            IsClosable="True"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,24,24"
            Width="320"/>
    </Grid>
</Page>
