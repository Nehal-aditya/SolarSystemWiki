<UserControl
    x:Class="SolarSystemWiki.Controls.EntryEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SolarSystemWiki.Models"
    xmlns:converters="using:SolarSystemWiki.Helpers"
    MinHeight="480"
    Width="620">

    <UserControl.Resources>
        <converters:StringToSolidBrushConverter x:Key="ColorToBrush"/>
    </UserControl.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        MaxHeight="680">

        <StackPanel Spacing="16" Padding="0,4,0,8">

            <!-- ── Validation error ── -->
            <InfoBar
                x:Name="ValidationInfoBar"
                IsOpen="False"
                Severity="Error"
                Title="Title is required"
                Message="Please enter a name for this entry before saving."
                IsClosable="True"/>

            <!-- ── Title ── -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Title *"
                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox
                    x:Name="TitleBox"
                    PlaceholderText="e.g. Jupiter, Halley's Comet, Ganymede…"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    CornerRadius="8"/>
            </StackPanel>

            <!-- ── Category + Emoji row ── -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Category -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Category" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Categories}"
                        SelectedItem="{x:Bind ViewModel.Category, Mode=TwoWay}"
                        CornerRadius="8"/>
                </StackPanel>

                <!-- Emoji -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Emoji" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBox
                        PlaceholderText=""
                        Text="{x:Bind ViewModel.Emoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="4"
                        FontSize="20"
                        TextAlignment="Center"
                        CornerRadius="8"/>
                </StackPanel>
            </Grid>

            <!-- ── Accent color picker ── -->
            <StackPanel Spacing="6">
                <TextBlock Text="Accent Color" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" x:Name="ColorSwatches">
                    <!-- Swatches generated in code-behind -->
                </StackPanel>
            </StackPanel>

            <!-- ── Summary ── -->
            <StackPanel Spacing="6">
                <TextBlock Text="Summary" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox
                    PlaceholderText="Write a short overview of this object…"
                    Text="{x:Bind ViewModel.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="80"
                    MaxHeight="160"
                    CornerRadius="8"/>
            </StackPanel>

            <!-- ── Divider ── -->
            <Border
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,4"/>

            <!-- ── Sections ── -->
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Sections"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"/>
                    <Button
                        Grid.Column="1"
                        Content="＋ Add Section"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="8"
                        Padding="10,6"
                        FontSize="12"
                        Command="{x:Bind ViewModel.AddSectionCommand}"/>
                </Grid>

                <!-- Sections list -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:WikiSection">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,4">

                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Grid.Column="0"
                                            PlaceholderText="Section heading…"
                                            Text="{x:Bind Heading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FontWeight="SemiBold"
                                            CornerRadius="6"/>

                                        <Button
                                            Grid.Column="1"
                                            ToolTipService.ToolTip="Remove section"
                                            Padding="8"
                                            CornerRadius="6"
                                            Click="RemoveSection_Click"
                                            Tag="{x:Bind}">
                                            <FontIcon
                                                Glyph="&#xE74D;"
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        </Button>
                                    </Grid>

                                    <TextBox
                                        PlaceholderText="Write the section content here…"
                                        Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="80"
                                        MaxHeight="200"
                                        CornerRadius="6"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty sections hint -->
                <TextBlock
                    x:Name="NoSectionsHint"
                    Text='No sections yet — click ＋ Add Section to break your entry into topics.'
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,4"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
